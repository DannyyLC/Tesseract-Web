generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================
enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  BUSINESS
  PRO
  ENTERPRISE
}

// Los créditos y el techo de tokens los define WORKFLOW_CATEGORIES en
// packages/types/src/billing/subscriptions/plans.ts, que es la fuente de verdad; estos
// comentarios son un reflejo y hay que moverlos si allá cambian.
enum WorkflowCategory {
  LIGHT // 1 crédito - Tareas simples, hasta 50k tokens
  STANDARD // 5 créditos - Workflows completos, hasta 200k tokens
  ADVANCED // 20 créditos - Multi-agente complejo, hasta 350k tokens
}

enum ModelTier {
  BASIC // gpt-4o-mini, claude-haiku - Solo para LIGHT workflows
  STANDARD // gpt-4o, claude-sonnet - Para LIGHT y STANDARD workflows
  PREMIUM // gpt-4-turbo, claude-opus - Para todos los workflows
}

enum TransactionType {
  SUBSCRIPTION_RENEWAL // Renovación mensual automática
  PLAN_UPGRADE // Upgrade de plan (STARTER -> GROWTH)
  PLAN_DOWNGRADE // Downgrade de plan (PRO -> BUSINESS)
  EXECUTION_DEDUCTION // Deducción por ejecución de workflow
  OVERAGE_CHARGE // Cargo por consumo en negativo
  MANUAL_ADJUSTMENT // Ajuste manual por admin
  REFUND // Reembolso
  ONE_TIME_PURCHASE // Compra de paquete de créditos adicional
}

enum InvoiceType {
  SUBSCRIPTION // Factura mensual de suscripción
  OVERAGE // Factura de overages del mes anterior
  ONE_TIME // Compra única de créditos
}

enum InvoiceStatus {
  DRAFT // Borrador, no enviada
  PENDING // Enviada, esperando pago
  PAID // Pagada exitosamente
  FAILED // Pago fallido
  REFUNDED // Reembolsada
}

/// Estado del CFDI (factura fiscal del SAT) de una factura.
///
/// Solo aplica a organizaciones mexicanas; el resto se queda en NOT_APPLICABLE para siempre.
/// STAMPING es un estado de reclamo: lo escribe quien va a llamar al PAC, y existe para que
/// dos procesos concurrentes no timbren la misma factura dos veces. Un CFDI duplicado obliga
/// a cancelar ante el SAT, que es justo lo que se quiere evitar.
enum CfdiStatus {
  NOT_APPLICABLE // Organización no mexicana: no se emite CFDI
  PENDING // Pendiente de timbrar
  STAMPING // Reclamada por un proceso que está llamando al PAC ahora mismo
  STAMPED // Timbrada: tiene folio fiscal
  FAILED // El timbrado falló; ver cfdiError / cfdiErrorKind
}

/// De quién es la culpa de que el timbrado fallara. Decide dos cosas: si el cron reintenta,
/// y qué mensaje ve el cliente en el panel.
enum CfdiErrorKind {
  CLIENT_DATA // RFC/razón social/CP no cuadran con el padrón del SAT: lo corrige el cliente
  INTERNAL // CSD vencido, timbres agotados, PAC caído: lo resolvemos nosotros
}

enum SubscriptionStatus {
  ACTIVE // Suscripción activa
  CANCELED // Cancelada, no renovará
  PAST_DUE // Pago vencido
  INCOMPLETE // Pago inicial incompleto
}

enum MessageAttachmentType {
  IMAGE
  AUDIO
}

enum MessageAttachmentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  UNSUPPORTED
}

enum UserRole {
  VIEWER
  ADMIN
  OWNER
  SUPER_ADMIN
}

enum ConversationStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum CompactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ConversationChannel {
  DASHBOARD
  WHATSAPP
  WEB
  API
  CRON
  MESSENGER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageFeedback {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum TriggerType {
  MANUAL
  API
  SCHEDULE
  WEBHOOK
  WHATSAPP
}

enum ToolConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  EXPIRED_AUTH
}

// Qué originó un snapshot de config en workflow_config_versions.
enum WorkflowVersionSource {
  BASELINE // Estado previo a la primera edición por UI. Nunca se poda.
  ADMIN_UI
  RESTORE
  CLONE
}

enum DangerLevel {
  SAFE
  WARNING
  DANGER
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum MessengerConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// ============================================
// ORGANIZATION (Tenant principal)
// ============================================
model Organization {
  id   String           @id @default(uuid())
  name String
  slug String           @unique
  plan SubscriptionPlan @default(FREE)

  // Defaults para nuevos workflows (opcionales)
  defaultMaxMessages     Int? // null = sin límite de mensajes por conversación
  defaultInactivityHours Int? // null = sin límite temporal de inactividad
  defaultMaxCostPerConv  Decimal? @db.Decimal(19, 4) // null = sin límite de costo por conversación

  // Credit System - Overage Control
  allowOverages Boolean @default(false) // Permite balance negativo
  overageLimit  Int? // Límite de créditos negativos (null = usar default del plan)

  // Overrides de límites del plan (para super admins)
  // null = usar valores por defecto del plan
  customMaxUsers       Int? // Override del límite de usuarios
  customMaxApiKeys     Int? // Override del límite de API keys
  customMaxWorkflows   Int? // Override del límite de workflows
  customMaxDatasets    Int? // Override del límite de datasets
  customMaxDatasetRows Int? // Override del límite de filas (sumadas entre todos los datasets)

  // Estado
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Desactivación temporal (diferente a deletedAt que es eliminación lógica)
  deactivatedAt      DateTime?
  deactivatedBy      String? // userId del que desactivó (Owner o SuperAdmin)
  deactivationReason String? // Motivo de la desactivación

  // Zona horaria de la organización (IANA). Fuente de verdad para gráficas y
  // para la hora local que reciben los agentes; un workflow puede sobrescribirla.
  timezone String @default("America/Mexico_City")

  // Escalabilidad futura
  shardKey String? @default(uuid())
  region   String? @default("us-central")
  metadata Json?

  // Billing (Stripe)
  // País de facturación (ISO 3166-1 alpha-2). Determina la moneda de cobro; nada que ver con
  // `region`, que es infraestructura. NULL = aún no contrata. Se escribe una sola vez, en el
  // checkout: Stripe congela la moneda del Customer en su primera factura, así que cambiarlo
  // después exigiría un Customer nuevo y dejaría huérfana cualquier deuda de overage.
  country          String?
  stripeCustomerId String? @unique

  // Relaciones
  users           User[]
  apiKeys         ApiKey[]
  workflows       Workflow[]
  executions      Execution[]
  tenantTools     TenantTool[]
  whatsappConfigs WhatsAppConfig[]
  messengerConfigs MessengerConfig[]
  auditLogs       AuditLog[]
  endUsers        EndUser[]
  cronTriggers    WorkflowCronTrigger[]
  datasets        Dataset[]

  // Credit System Relations
  creditBalance      CreditBalance?
  subscription       Subscription?
  fiscalProfile      FiscalProfile?
  creditTransactions CreditTransaction[]
  invoices           Invoice[]
  conversations      Conversation[]
  messages           Message[]
  messageAttachments MessageAttachment[]
  userNotifications  UserNotification[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([deactivatedAt])
  @@index([plan])
  @@map("organizations")
}

// ============================================
// SUBSCRIPTION (Suscripción mensual activa)
// ============================================
model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Plan y estado
  plan   SubscriptionPlan
  status SubscriptionStatus @default(ACTIVE)

  // Ciclo de facturación
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime // Calculado: currentPeriodStart + 1 mes
  cancelAtPeriodEnd  Boolean  @default(false) // Si true, no renueva al final del periodo

  // Downgrade programado (se aplica al final del periodo = currentPeriodEnd)
  pendingPlanChange     SubscriptionPlan? // null = sin cambio pendiente, ej: GROWTH
  planChangeRequestedAt DateTime? // Cuándo el usuario SOLICITÓ el cambio
  planChangeRequestedBy String? // userId que solicitó el cambio

  // Stripe
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Moneda en la que se cobra, tomada de la factura. El default cubre a las suscripciones
  // anteriores a la facturación regionalizada, que eran todas en USD. Es informativa: la
  // fuente de verdad es el Customer de Stripe, que la congela en su primera factura.
  currency String @default("usd")

  // Campos personalizables para ENTERPRISE
  customMonthlyPrice   Decimal? @db.Decimal(19, 4) // null = usar precio estándar del plan
  // null = usar el default del plan. Los valores viven en `PLANS` (packages/types) y no se
  // repiten aquí a propósito: se recalibran contra el costo real y las copias quedan obsoletas.
  customMonthlyCredits Int?
  customMaxWorkflows   Int?
  customOverageLimit   Int? // null = calcular automático (1 mes de créditos)
  customFeatures       Json? // Features especiales: { sla: "99.9%", support: "24/7", ... }

  // Timestamps
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  canceledAt         DateTime? // Fecha de cancelación
  creditTransactions CreditTransaction[]
  invoices           Invoice[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([pendingPlanChange])
  @@index([plan])
  @@map("subscriptions")
}

// ============================================
// CREDIT BALANCE (Balance de créditos por organización)
// ============================================
model CreditBalance {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Balance actual (puede ser negativo si hay overage)
  balance Int @default(0)

  // Contadores históricos acumulativos
  lifetimeEarned Int @default(0) // Total créditos comprados históricamente
  lifetimeSpent  Int @default(0) // Total créditos consumidos

  // Contadores del mes actual
  // NOTA: Se calculan sumando CreditTransaction del periodo actual (subscription.currentPeriodStart/End)
  // Se actualizan con cada transacción, no se "reinician" sino que se recalculan desde transacciones
  currentMonthSpent   Int     @default(0) // Créditos gastados este mes
  currentMonthCostUSD Decimal @default(0) @db.Decimal(19, 4) // Costo real en USD este mes (para análisis interno)

  // Overage Billing Snapshot (Temporal)
  invoicedOverageCredits Int @default(0) // Créditos de overage ya facturados (snapshot invoice.created) pero aun no pagados

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balance])
  @@index([updatedAt])
  @@map("credit_balances")
}

// ============================================
// CREDIT TRANSACTION (Historial de transacciones de créditos)
// ============================================
model CreditTransaction {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Tipo de transacción
  type TransactionType

  // Monto y balances (para auditoría completa)
  amount        Int // Positivo = ingreso, Negativo = gasto
  balanceBefore Int // Balance antes de la transacción
  balanceAfter  Int // Balance después de la transacción

  // Referencias opcionales según el tipo de transacción
  subscriptionId String? // Para SUBSCRIPTION_RENEWAL, PLAN_UPGRADE, PLAN_DOWNGRADE
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  executionId    String?       @unique // Solo para EXECUTION_DEDUCTION — un cobro por ejecución. MANUAL_ADJUSTMENT usa metadata.originalExecutionId
  execution      Execution?    @relation("ExecutionTransaction", fields: [executionId], references: [id])
  invoiceId      String? // Para compras (ONE_TIME_PURCHASE, OVERAGE_CHARGE)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])

  // Metadata de la ejecución (para reportes y análisis)
  workflowCategory WorkflowCategory? // LIGHT/STANDARD/ADVANCED (si es deducción por ejecución)
  costUSD          Decimal? @db.Decimal(19, 8) // Costo real en USD de esta transacción (para análisis interno)

  // Información adicional
  description String? // Descripción legible: "Renovación plan GROWTH", "Ejecución workflow Ventas"
  metadata    Json? // Info extra: { tokens: 450, model: "gpt-4o", duration: 1250 }

  // Timestamp
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([type, createdAt])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@map("credit_transactions")
}

// ============================================
// INVOICE (Facturas de pago - Stripe)
// ============================================
model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identificación
  invoiceNumber String        @unique // Auto-generado: INV-202601-0001
  type          InvoiceType // SUBSCRIPTION, OVERAGE, ONE_TIME
  status        InvoiceStatus @default(PENDING)

  // Referencias opcionales
  subscriptionId String? // Si es factura de suscripción mensual
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Periodo facturado (para facturas mensuales)
  periodStart DateTime? // Inicio del periodo
  periodEnd   DateTime? // Fin del periodo

  // Montos
  subtotal       Decimal              @db.Decimal(19, 4) // Precio base (suscripción o paquete)
  overageCredits Int                  @default(0) // Créditos en negativo del mes anterior
  overageAmount  Decimal              @default(0) @db.Decimal(19, 4) // overageCredits * $0.01
  tax            Decimal              @default(0) @db.Decimal(19, 4) // Impuestos si aplican
  total          Decimal              @db.Decimal(19, 4) // subtotal + overageAmount + tax

  // Stripe
  stripeInvoiceId       String? @unique
  stripePaymentIntentId String?
  stripeHostedUrl       String? // URL para que el cliente pague
  stripePdfUrl          String? // URL del PDF generado por Stripe

  // CFDI (factura fiscal del SAT). Solo se llenan para organizaciones con country = 'MX'.
  //
  // `cfdiUuid` es el folio fiscal que devuelve el PAC, y su unicidad es el candado duro de
  // "se timbra una sola vez": aunque fallara el reclamo por estado, la base rechazaría el
  // segundo timbrado de la misma factura.
  cfdiStatus        CfdiStatus     @default(NOT_APPLICABLE)
  cfdiUuid          String?        @unique // Folio fiscal (UUID del timbre)
  cfdiStampedAt     DateTime?
  cfdiFolioNumber   Int? // Folio propio que se le manda al PAC; permite buscar un intento a medias
  facturapiId       String?        @unique // ID de la factura en Facturapi
  cfdiXmlPath       String? // Objeto en el bucket de GCS
  cfdiPdfPath       String?
  cfdiError         String? // Último mensaje de error del PAC
  cfdiErrorKind     CfdiErrorKind?
  cfdiAttempts      Int            @default(0)
  cfdiLastAttemptAt DateTime?

  // Fechas
  paidAt DateTime? // Cuándo se pagó
  dueAt  DateTime? // Fecha límite de pago

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  creditTransactions CreditTransaction[]

  @@index([organizationId, createdAt])
  @@index([type, status])
  @@index([status, dueAt])
  @@index([subscriptionId])
  // Barrido del cron de reintentos: filtra por estado y descarta las recién pagadas.
  @@index([cfdiStatus, paidAt])
  @@map("invoices")
}

// ============================================
// FISCAL PROFILE (Datos fiscales para el CFDI)
// ============================================

/// Datos fiscales con los que se le emite el CFDI a una organización mexicana.
///
/// Es opcional a propósito: no se bloquea el checkout por no tenerlo. Una organización sin
/// perfil se cobra igual y su factura queda pendiente hasta que llene los datos y la genere
/// desde el panel.
///
/// El SAT valida RFC + razón social + código postal contra su padrón al timbrar, así que los
/// tres tienen que venir *exactamente* como aparecen en la Constancia de Situación Fiscal.
/// Por eso se validan contra el PAC al guardarlos y no al cobrar: es mejor que el cliente se
/// entere del error cuando llena el formulario que cuando ya pagó.
model FiscalProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rfc       String // 12 caracteres (persona moral) o 13 (persona física), en mayúsculas
  legalName String // Razón social EXACTA de la Constancia de Situación Fiscal
  zipCode   String // CP del domicilio fiscal (DomicilioFiscalReceptor)
  taxRegime String // Clave del catálogo c_RegimenFiscal del SAT: 601, 612, 626…
  cfdiUse   String @default("G03") // Clave del catálogo c_UsoCFDI
  email     String // Correo fiscal del receptor

  // Facturapi guarda su propia copia del receptor; se referencia para no reenviar los datos
  // en cada timbrado.
  facturapiCustomerId String? @unique

  /// Última vez que el PAC aceptó estos datos contra el padrón del SAT. En NULL significa
  /// "sin validar": no se intenta timbrar, porque el SAT lo rechazaría.
  validatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fiscal_profiles")
}

// ============================================
// USER (Empleado de una Organization)
// ============================================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String
  password String?
  googleId String? @unique

  // Verificación
  emailVerified                 Boolean   @default(false)
  emailVerificationToken        String?   @unique
  emailVerificationTokenExpires DateTime? // Expiración del token de verificación

  // Reset password
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  // Secreto en pruebas: se llena al iniciar el alta y solo se promueve a
  // twoFactorSecret cuando el usuario confirma un código. Así un alta abandonada
  // nunca deja la cuenta sin segundo factor.
  twoFactorPendingSecret String?
  // Último paso TOTP consumido (epoch/30). Impide reusar un código dentro de su ventana.
  twoFactorLastUsedStep  Int?

  // Rol y estado
  role     UserRole @default(VIEWER)
  isActive Boolean  @default(true)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  lastLoginAt DateTime?

  // Preferencias
  avatar String?

  // Relación con Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relaciones
  refreshTokens    RefreshToken[]
  executionsManual Execution[]
  conversations    Conversation[]
  auditLogs        AuditLog[]
  notifications    UserNotification[]
  tenantTools      TenantTool[]
  backupCodes      UserBackupCode[]
  datasets         Dataset[]
  blockedEndUsers  EndUser[]          @relation("EndUserBlockedBy")

  @@index([organizationId])
  @@index([role])
  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

/// Códigos de respaldo de 2FA: permiten entrar cuando se pierde el autenticador.
/// Se guardan hasheados con SHA-256 (determinista, para búsqueda indexada) porque
/// son aleatorios de alta entropía y no contraseñas elegidas por el usuario.
model UserBackupCode {
  id       String    @id @default(uuid())
  codeHash String    @unique
  usedAt   DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_backup_codes")
}

// ============================================
// END USER (Cliente externo del negocio)
// ============================================
model EndUser {
  id String @id @default(uuid())

  // Identificadores flexibles
  phoneNumber String? // Para WhatsApp
  email       String? // Para web/email
  externalId  String? // ID del sistema del cliente (ej: HubSpot contact ID)
  sessionId   String? // Para usuarios anónimos

  // Información del usuario
  name     String?
  avatar   String?
  metadata Json? // Datos adicionales flexibles

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  /// Lista negra: con valor, sus mensajes entrantes se descartan en el webhook — antes de
  /// bufferear, de agendar la tarea, de transcribir audio y de ejecutar el workflow, así que
  /// un contacto bloqueado no cuesta ni un crédito.
  ///
  /// Va aquí y no en una tabla aparte porque `EndUser` YA es la identidad del interlocutor por
  /// organización, guardada con la llave exacta que entrega el proveedor (el `from` crudo de
  /// WhatsApp, `messenger:<pageId>:<psid>` en Messenger). El match es por índice único y no hay
  /// normalización de por medio que pueda fallar; y el bloqueo es de la organización entera, no
  /// de un workflow: una lista negra que se esquiva cambiando de canal no es una lista negra.
  ///
  /// `DateTime?` en vez de booleano, igual que `deletedAt`: da "bloqueado desde cuándo" gratis.
  blockedAt       DateTime?
  blockedReason   String?
  blockedByUserId String?
  blockedBy       User?     @relation("EndUserBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)

  // Relación con Organization (multi-tenancy)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relaciones
  conversations Conversation[]

  @@unique([organizationId, phoneNumber])
  @@unique([organizationId, email])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([phoneNumber])
  @@index([email])
  @@index([sessionId])
  @@index([lastSeenAt])
  // Sirve al filtro "solo bloqueados" del listado de contactos, que siempre acota por organización.
  @@index([organizationId, blockedAt])
  @@map("end_users")
}

// ============================================
// CONVERSATION (Sesión de chat)
// ============================================
model Conversation {
  id String @id @default(uuid())

  // USUARIO INTERNO (empleado usando dashboard) - OPCIONAL
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // USUARIO EXTERNO (cliente final) - OPCIONAL
  endUserId String?
  endUser   EndUser? @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  // REGLA DE NEGOCIO: Uno de los dos debe existir (userId o endUserId), pero NO ambos  
  // Workflow/Agente relacionado
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Configuración de WhatsApp (opcional - solo si el canal es whatsapp)
  whatsappConfigId  String?
  whatsappConfig    WhatsAppConfig? @relation(fields: [whatsappConfigId], references: [id])
  phoneNumberSender String?

  // Configuración de Messenger (opcional - solo si el canal es messenger)
  messengerConfigId String?
  messengerConfig   MessengerConfig? @relation(fields: [messengerConfigId], references: [id])
  // PSID: identificador del usuario, único por página. Es el equivalente a
  // `phoneNumberSender` en WhatsApp y lo que permite reencontrar la conversación.
  messengerSenderId String?

  // Metadata de la conversación
  title   String? // "Consulta sobre productos", "Testing agente ventas"
  channel ConversationChannel
  status  ConversationStatus  @default(ACTIVE)

  messageCount     Int       @default(0) // Contador de mensajes
  totalTokens      Int       @default(0) // Suma de tokens usados
  totalCost        Decimal   @default(0) @db.Decimal(19, 8) // Costo acumulado en USD
  isHumanInTheLoop Boolean   @default(false) // Si true, la IA no responde, espera humano
  // Requiere que alguien del equipo dé seguimiento por fuera del bot. Lo levanta
  // cualquier workflow dejando `requires_follow_up: true` en sus variables
  // persistidas, o un humano desde la UI. Solo se apaga a mano: que el bot deje
  // de pedirlo no significa que el seguimiento ya se hizo.
  needsFollowUp    Boolean   @default(false)
  followUpReason   String?   // Por qué se marcó (se muestra en la UI)
  isCompacting     Boolean   @default(false) // Lock de compactación por conversación
  // Copia congelada de `Workflow.isInternal` al momento de crear la conversación. Igual
  // razón que en `Execution.isInternalWorkflow`: no confundir con el `isInternal` calculado
  // en el DTO de salida de `ConversationsService.findAll()` (`!!userId`, otro concepto —
  // "atendida por alguien del equipo" vs. "del workflow interno de super admin").
  isInternalWorkflow Boolean @default(false)
  compactingLockedAt DateTime? // Timestamp para TTL y recuperación de lock stale
  lastMessageAt    DateTime? // Último mensaje (para calcular inactividad)
  lastMessageRole  ChatRole? // Para auto-cierre eficiente
  autoCloseAt      DateTime? // Próximo autocierre calculado según configuración de inactividad
  currentCompactionId String? @unique // FK a la compactación activa (nullable para conversaciones nuevas)

  // Información adicional
  metadata Json?   @db.JsonB // Tags, categorías, sentimiento, etc.

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime? // Cuándo se cerró la conversación
  deletedAt DateTime? // Soft delete

  // Relaciones
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentCompaction ConversationCompaction? @relation("ActiveCompaction", fields: [currentCompactionId], references: [id])

  messages   Message[] // Una conversación tiene muchos mensajes
  executions Execution[] // Ejecuciones asociadas a esta conversación
  compactions ConversationCompaction[] @relation("CompactionHistory")

  @@index([organizationId])
  @@index([userId])
  @@index([endUserId])
  @@index([workflowId])
  @@index([whatsappConfigId])
  @@index([messengerConfigId])
  @@index([status])
  @@index([channel])
  @@index([needsFollowUp]) // El listado ordena y filtra por esto
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([autoCloseAt])
  @@index([closedAt])
  @@index([deletedAt])
  @@index([compactingLockedAt])
  @@index([workflowId, status, lastMessageAt])
  @@index([channel, whatsappConfigId, phoneNumberSender, status, createdAt])
  // Cubre el orden del listado del dashboard: filtra por organizacion, excluye
  // conversaciones de workflows internos, y ordena intervenidas -> seguimiento ->
  // estatus -> ultimo mensaje.
  @@index([organizationId, isInternalWorkflow, isHumanInTheLoop(sort: Desc), needsFollowUp(sort: Desc), status, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationCompaction {
  id                  String           @id @default(uuid())
  conversationId      String
  version             Int
  summary             String?          @db.Text // Nullable para estados PENDING/FAILED
  sourceMessageFromId String?
  sourceMessageToId   String?
  tokensBefore        Int
  tokensAfter         Int
  compressionRatio    Float
  modelUsed           String
  status              CompactionStatus
  error               String?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  conversation Conversation @relation("CompactionHistory", fields: [conversationId], references: [id], onDelete: Cascade)
  activeFor     Conversation? @relation("ActiveCompaction")

  @@unique([conversationId, version])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("conversation_compactions")
}

// ============================================
// MESSAGE (Mensaje individual)
// ============================================
model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role ChatRole

  content     String              @db.Text // Texto del mensaje (siempre presente) - puede ser largo
  attachments MessageAttachment[]

  metadata Json? @db.JsonB

  // Datos de IA (si es respuesta del asistente)
  model     String?
  tokens    Int?
  cost      Decimal? @db.Decimal(19, 8)
  latencyMs Int?

  // Tool calls (cuando el asistente solicita ejecutar herramientas)
  toolCalls Json? @db.JsonB
  // Estructura de toolCalls:
  // [
  //   {
  //     "id": "call_abc123",              // ID único del tool call
  //     "type": "function",               // Tipo de llamada (siempre "function")
  //     "function": {
  //       "name": "get_weather",          // Nombre de la herramienta
  //       "arguments": "{\"city\":\"NY\"}" // Argumentos en JSON string
  //     }
  //   }
  // ]

  toolResults Json? @db.JsonB
  // Estructura de toolResults:
  // [
  //   {
  //     "tool_call_id": "call_abc123",    // ID del tool call correspondiente
  //     "role": "tool",                   // Siempre "tool"
  //     "name": "get_weather",            // Nombre de la herramienta ejecutada
  //     "content": "22°C, sunny"          // Resultado de la ejecución (string o JSON)
  //   }
  // ]

  createdAt DateTime @default(now())

  // Feedback del usuario
  feedback        MessageFeedback?
  feedbackComment String?          @db.Text

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("messages")
}

model MessageAttachment {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type             MessageAttachmentType
  mimeType         String
  sourceUrl        String
  sizeBytes        Int?
  sha256           String?
  contentHash      String?
  processingStatus MessageAttachmentStatus @default(PENDING)
  processedText    String?                 @db.Text
  processedAt      DateTime?
  processingError  String?                 @db.Text
  processor        String?
  processorVersion String?

  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId, createdAt])
  @@index([organizationId, contentHash])
  @@index([processingStatus])
  @@index([createdAt])
  @@map("message_attachments")
}

// ============================================
// LLM MODEL (Modelos de IA con precios)
// ============================================
model LlmModel {
  id String @id @default(uuid())

  // Identificación del modelo
  provider  String // "openai", "anthropic", "google"
  modelName String // "gpt-4o", "claude-3-5-sonnet", etc.

  // Tier del modelo (para restricciones por workflow category)
  tier ModelTier // BASIC, STANDARD, PREMIUM

  // Categoría del modelo LLM (agrupación dinámica, gestionada por super admin).
  // Habilita agrupación en UI y, a futuro, routing/failover por categoría+tier.
  llmCategoryId String?
  llmCategory   LlmModelCategory? @relation(fields: [llmCategoryId], references: [id], onDelete: SetNull)

  // Precios por 1 millón de tokens
  inputPricePer1m  Decimal @db.Decimal(19, 6) // Precio por 1,000,000 tokens de entrada
  outputPricePer1m Decimal @db.Decimal(19, 6) // Precio por 1,000,000 tokens de salida

  // Ventana de contexto
  contextWindow        Int // Tokens máximos del modelo (ej: 128000 para GPT-4o)
  recommendedMaxTokens Int // Tokens recomendados para conversaciones (ej: 100000)

  // Vigencia del precio
  effectiveFrom DateTime  @default(now()) // Desde cuándo aplica
  effectiveTo   DateTime? // Hasta cuándo (null = actual)

  // Estado
  isActive Boolean @default(true)
  currency String  @default("USD")

  // Metadata
  notes     String? // "Aumento de precios Q1 2025"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, modelName, effectiveFrom])
  @@index([provider, modelName, isActive])
  @@index([isActive, effectiveFrom])
  @@index([tier, isActive])
  @@index([llmCategoryId])
  @@map("llm_models")
}

// ============================================
// LLM MODEL CATEGORY (Categoría de modelos LLM - global, gestionada por super admin)
// ============================================
// Entidad de primera clase para agrupar modelos LLM. Creada dinámicamente por
// el super admin (no es un enum). Habilita agrupación en UI y, a futuro,
// estadísticas y routing/failover (elegir otro modelo de la misma categoría y
// tier si un proveedor falla). No está scopeada por organización.
model LlmModelCategory {
  id          String  @id @default(uuid())
  name        String  @unique // nombre canónico, ej: "chat", "reasoning"
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models LlmModel[]

  @@index([isActive])
  @@map("llm_model_categories")
}

// ============================================
// TOOL CATALOG (Catálogo de tools - controlado por sistema)
// ============================================
model ToolCatalog {
  id String @id @default(uuid())

  // Identificación
  toolName    String  @unique // "google_calendar", "hubspot", "slack"
  displayName String // "Google Calendar", "HubSpot", "Slack"
  description String? // Descripción de qué hace esta tool
  provider    String? // "google", "microsoft", "custom"

  // Control de disponibilidad (sistema)
  isActive Boolean @default(false) // Si está lista para producción
  isInBeta Boolean @default(false) // Si está en testing/beta

  // Metadata para UI y Auth
  icon       String? // URL o nombre del ícono
  category   String? // "productivity", "crm", "communication"
  authConfig Json? // Configuraciones específicas de OAuth como clientId o custom fields

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  functions   ToolFunction[]
  tenantTools TenantTool[] // Instancias de organizaciones que usan esta tool

  @@index([isActive])
  @@index([category])
  @@map("tool_catalog")
}

// ============================================
// TOOL FUNCTION (Funciones de cada tool - controlado por sistema)
// ============================================
model ToolFunction {
  id String @id @default(uuid())

  // Relación con ToolCatalog
  toolCatalogId String
  toolCatalog   ToolCatalog @relation(fields: [toolCatalogId], references: [id], onDelete: Cascade)

  // Identificación de la función
  functionName String // "check_availability", "create_event", "delete_event"
  displayName  String // "Verificar Disponibilidad", "Crear Evento"
  description  String? // Descripción de qué hace esta función

  // Categorización (para UI y control)
  category String? @default("general") // "read", "write", "delete"

  // OAuth Scopes que esta función específica requiere
  oauthScopes String[] @default([])

  // Control de disponibilidad
  isActive Boolean @default(false) // Si está lista para uso
  isInBeta Boolean @default(false) // Si está en testing

  // Metadata para UI
  icon        String? // Ícono específico de la función
  dangerLevel DangerLevel? @default(SAFE)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([toolCatalogId, functionName])
  @@index([toolCatalogId, isActive])
  @@index([toolCatalogId, category])
  @@index([isActive])
  @@map("tool_functions")
}

// ============================================
// TENANT TOOL (Conexiones con servicios externos)
// ============================================
model TenantTool {
  id String @id @default(uuid())

  // Relación con el catálogo (NUEVO - obligatorio)
  // Define QUÉ tool es esta instancia (google_calendar, hubspot, etc)
  toolCatalogId String
  toolCatalog   ToolCatalog @relation(fields: [toolCatalogId], references: [id], onDelete: Restrict)

  // Identificación personalizada
  displayName String // "Google Calendar - Ventas", "HubSpot Portal US"

  // Configuración específica del tenant (NO secretos)
  config Json? // { "portal_id": "123", "default_pipeline": "ventas" }

  // Funciones permitidas al momento de crear la tool (autorización granular)
  // Ej: ["create_event", "list_events"]
  allowedFunctions Json? @db.JsonB

  // Estado de conexión
  isConnected     Boolean              @default(false)
  status          ToolConnectionStatus @default(DISCONNECTED)
  connectionError String? // Último error si falló
  connectedAt     DateTime?
  lastUsedAt      DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete para preservar histórico de ejecuciones

  // Relación con organización
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Quién autorizó esta conexión OAuth. Solo este usuario debería poder editar/eliminar la tool.
  createdByUserId String?
  user            User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Workflows que usan esta tool
  workflows  Workflow[]            @relation("WorkflowToTenantTool")
  credential TenantToolCredential?

  // NOTE: La unicidad de (organizationId, displayName) entre tools ACTIVAS se enforza con un partial unique
  // index en el SQL: WHERE "deletedAt" IS NULL. Prisma no soporta partial unique indexes directamente.
  // El índice regular de abajo cubre queries que incluyen tools eliminadas (historial, auditoría).
  @@index([organizationId, displayName])
  @@index([organizationId])
  @@index([toolCatalogId])
  @@index([isConnected])
  @@index([deletedAt])
  @@map("tenant_tools")
}

// ============================================
// TENANT TOOL CREDENTIAL (Bóveda PII)
// ============================================
model TenantToolCredential {
  id String @id @default(uuid())

  // Relación 1:1 con la herramienta
  tenantToolId String     @unique
  tenantTool   TenantTool @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)

  // Proveedor de la identidad
  oauthProvider String // "google", "hubspot", etc.

  // Tokens Cifrados con KMS + Tink
  encryptedAccessToken  String   @db.Text
  encryptedRefreshToken String?  @db.Text
  tokenExpiresAt        DateTime

  // Scopes reales otorgados por el usuario
  scopes Json? @db.JsonB

  // Timestamps (NO deletedAt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_tool_credentials")
}

// ============================================
// DATASET (Mini base de datos del tenant, consultable por el LLM)
// ============================================
/// Los datos propios del cliente que su agente necesita conocer: un catálogo de vehículos, de
/// armas, de autos en venta. NO es la base de datos del cliente — es la vista que su agente
/// consume. De ahí la regla de producto: todo lo que esté aquí lo ve el LLM; si no quiere que lo
/// sepa, no sube esa columna.
///
/// La estructura la define el cliente desde la UI, así que el schema es DATO, no código — el mismo
/// patrón que `ToolCatalog`/`ToolFunction` y que el `config_schema` del catálogo de nodos del
/// pipeline. A partir de `fields` se genera la firma tipada de la tool que el modelo invoca.
model Dataset {
  id String @id @default(uuid())

  name String
  /// Se inyecta en la description de la tool: es lo que le dice al modelo para qué sirve.
  description String?

  /// Definición de columnas: `[{ key, label, type, options?, formula?, order, deletedAt? }]`.
  ///
  /// Va como JSON y no como tabla aparte porque el tope son 30 columnas y porque el borrado es
  /// lógico: marcar `deletedAt` en un field lo saca de la UI y de la firma de la tool **sin tocar
  /// los valores ya guardados en `DatasetRecord.data`**, así un borrado por error se deshace.
  ///
  /// Tipos soportados: `text`, `number`, `select`, `date`. El tipo no es decoración de UI — define
  /// qué puede hacer el LLM con la columna: `select` filtra por valores conocidos (el modelo solo
  /// ve los declarados, no puede inventar uno), `number` y `date` filtran por rango y ordenan,
  /// `text` alimenta la búsqueda libre.
  ///
  /// Un `number` con `formula` es una columna CALCULADA: su valor se deriva de otras columnas
  /// numéricas al escribir la fila y se guarda en `DatasetRecord.data` como un número normal. Sigue
  /// siendo `type: 'number'` a propósito, para que el filtro por rango, el orden `::numeric` y la
  /// firma de la tool no tengan que saber que las fórmulas existen.
  ///
  /// La evolución es SOLO ADITIVA: `key` es inmutable una vez creada (el `label` se edita libre),
  /// agregar columna siempre se puede, borrar es soft-delete y cambiar `type` con registros
  /// existentes no se permite. Sin esta regla, el primer cliente que renombre una columna rompe su
  /// propio agente en silencio.
  fields Json @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  records   DatasetRecord[]
  workflows Workflow[]      @relation("WorkflowToDataset")

  @@index([organizationId, deletedAt])
  @@map("datasets")
}

/// Una fila del dataset. `data` es un objeto plano cuyas claves son las `key` de los fields vivos.
///
/// Los números se guardan como números JSON y las fechas como `YYYY-MM-DD` (sin hora — un catálogo
/// nunca la necesita, y así se esquiva por completo el problema de zonas horarias del resto del
/// sistema). El validador lo garantiza en la escritura para que el filtro por rango pueda castear
/// `(data->'precio')::numeric` sin reventar contra un string.
model DatasetRecord {
  id String @id @default(uuid())

  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  data Json @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: el índice GIN sobre `data` se crea en el SQL de la migración (Prisma no expresa
  // `jsonb_path_ops`). Acelera los filtros por igualdad de los campos `select`.
  @@index([datasetId])
  @@map("dataset_records")
}

// ============================================
// API KEY
// ============================================
model ApiKey {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Key hasheada (determinista para búsqueda rápida)
  keyHash String @unique

  // Estado y uso
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Tracking
  executions Execution[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("api_keys")
}

// ============================================
// REFRESH TOKEN
// ============================================
model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  // Familia de tokens (para detectar reuso)
  familyId          String
  previousTokenHash String?

  // Expiración y revocación
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  // Metadata del dispositivo
  userAgent String?
  ipAddress String?
  deviceId  String?

  // Timestamps
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  // Relación
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// WORKFLOW (Agente)
// ============================================
model Workflow {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Configuración del workflow - Estructura unificada para todos los tipos de grafos
  config Json
  // Estructura unificada:
  // {
  //   "type": "agent",
  //   "graph": {
  //     "type": "react",                 // "react", "supervisor", "router", "sequential", "parallel"
  //     "config": {
  //       // Configuración específica del tipo de grafo
  //       // REACT: { "max_iterations": 10, "allow_interrupts": false }
  //       // SUPERVISOR: { "routing_strategy": "llm_based", "max_iterations": 20 }
  //       // ROUTER: { "routes": [...], "default_route": "agent_name" }
  //       // SEQUENTIAL: { "steps": [{"agent": "a", "output_to": "data"}, ...] }
  //     }
  //   },
  //   "mediaProcessing": {
  //     "ocrPrompt": "Extrae el total y la fecha de esta factura." // Opcional: Prompt para extracción de imágenes
  //   },
  //   "agents": {
  //     // Para grafos simples (react): un agente "default"
  //     "default": {
  //       "model": "gpt-4o",
  //       "temperature": 0.7,
  //       "system_prompt": "Eres un asistente...",
  //       "tools": ["tenant-tool-uuid-1", "tenant-tool-uuid-2"]  // IDs de TenantTools
  //     },
  //     // Para grafos multi-agente (supervisor, router, sequential): múltiples agentes
  //     "supervisor": {
  //       "model": "gpt-4o",
  //       "system_prompt": "Coordinas agentes...",
  //       "tools": []
  //     },
  //     "sales_agent": {
  //       "model": "gpt-4o",
  //       "temperature": 0.5,
  //       "system_prompt": "Gestionas ventas...",
  //       "tools": ["tenant-tool-uuid-calendar-ventas"]
  //     },
  //     "marketing_agent": {
  //       "model": "gpt-4o-mini",
  //       "temperature": 0.3,
  //       "system_prompt": "Gestionas marketing...",
  //       // OPCIÓN 1: Array simple de IDs (sin restricciones de funciones)
  //       "tools": ["tenant-tool-uuid-calendar-marketing"]
  //     },
  //     "restricted_agent": {
  //       "model": "gpt-4o",
  //       "system_prompt": "Agente con permisos limitados...",
  //       // OPCIÓN 2: Array de objetos con control granular de funciones
  //       "tools": [
  //         {
  //           "id": "tenant-tool-uuid-calendar",
  //           "functions": ["check_availability", "list_events"]  // Solo estas funciones
  //         },
  //         {
  //           "id": "tenant-tool-uuid-calculator"  // Sin "functions" = usa todas
  //         }
  //       ]
  //     }
  //   }
  // }
  //
  // FORMATOS SOPORTADOS PARA "tools":
  // 
  // 1. String simple (sin control granular):
  //    "tools": ["uuid-1", "uuid-2"]
  //    → Puede usar TODAS las funciones de cada tool
  //
  // 2. Objeto con funciones específicas (control granular):
  //    "tools": [
  //      {"id": "uuid-1", "functions": ["func1", "func2"]},  // Solo func1 y func2
  //      {"id": "uuid-2"}  // Sin "functions" = usa todas
  //    ]
  //    → Puede usar solo las funciones especificadas
  //
  // 3. Array vacío (sin tools):
  //    "tools": []
  //    → El agente no tiene acceso a ninguna tool

  // Tools habilitadas para este workflow (relación con TenantTools específicas)
  // Representa el POOL de tools disponibles - cada agente decide cuáles usar en config.agents[].tools
  tenantTools TenantTool[] @relation("WorkflowToTenantTool")

  // Datasets que este workflow puede consultar. El enlace es N:M porque un workflow consume
  // varios catálogos (RGM: vehículos, armas, simuladores) y un mismo catálogo sirve a varios
  // workflows (WhatsApp y web). Cada enlace se materializa como un TenantTool de tipo `dataset`.
  datasets Dataset[] @relation("WorkflowToDataset")

  // Credit System - Workflow Category
  category              WorkflowCategory // Asignado por admin. Costo en créditos: WORKFLOW_CATEGORIES (packages/types)
  maxTokensPerExecution Int // Techo de historial de conversación (50k/200k/350k según category)

  maxMessages            Int? // null = sin límite de mensajes
  inactivityHours        Int? // null = sin límite temporal
  maxCostPerConversation Decimal? @db.Decimal(19, 4) // null = sin límite de costo

  // Versionado
  version Int @default(1)

  // Estado
  isActive Boolean @default(true)
  isPaused Boolean @default(false)

  // Creado y editado solo por super admin (admin/workflows). Nunca lo ve ni lo ejecuta el
  // cliente, no gasta créditos, no cuenta en sus estadísticas ni en el límite de workflows de
  // su plan. Sirve para construir/probar un workflow dentro de la organización real del
  // cliente antes de publicarlo (poner en false cuando esté listo).
  isInternal Boolean @default(false)

  // Programación
  schedule    String? // Cron expression
  timezone    String? // null = hereda de Organization.timezone
  triggerType TriggerType[] @default([])

  // Configuración de ejecución
  timeout    Int @default(300)
  maxRetries Int @default(3)

  // Estadísticas (incluye tracking de créditos)
  totalExecutions        Int       @default(0)
  successfulExecutions   Int       @default(0)
  failedExecutions       Int       @default(0)
  totalCreditsConsumed   Int       @default(0) // Total créditos gastados por este workflow
  avgCreditsPerExecution Float? // Promedio de créditos por ejecución
  lastExecutedAt         DateTime?
  avgExecutionTime       Float?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relación
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relaciones
  executions      Execution[]
  whatsappConfigs WhatsAppConfig[]
  messengerConfigs MessengerConfig[]
  tags            Tag[]            @relation("TagToWorkflow")
  conversations   Conversation[]
  apiKeys         ApiKey[]
  cronTriggers    WorkflowCronTrigger[]
  configVersions  WorkflowConfigVersion[]

  @@index([organizationId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([lastExecutedAt])
  @@index([triggerType])
  @@index([category])
  @@map("workflows")
}

/// Historial de configs de un workflow. Antes de esto, `workflows.config` se
/// sobrescribía y el estado anterior se perdía (`workflows.version` es solo un
/// contador).
///
/// Se guardan snapshots COMPLETOS, no diffs: restaurar es un solo SELECT y una fila
/// corrupta no invalida el resto de la historia. Postgres los TOAST-comprime solo
/// (~300 KB de config quedan en ~100 KB en disco), así que el costo es marginal.
/// Los diffs se calculan al vuelo para mostrarlos, igual que `git diff`.
model WorkflowConfigVersion {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /// Valor de `workflows.version` que representa este snapshot.
  version Int
  config  Json

  /// sha256 del JSON canónico (claves ordenadas). Evita escribir una fila cuando
  /// se guarda sin cambios reales.
  configHash String
  sizeBytes  Int

  /// El baseline es el estado previo a la primera edición por UI: nunca se poda.
  isBaseline Boolean               @default(false)
  note       String?
  source     WorkflowVersionSource @default(ADMIN_UI)

  createdById    String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  @@unique([workflowId, version])
  @@index([workflowId, createdAt])
  @@map("workflow_config_versions")
}

// ============================================
// EXECUTION (Ejecución de un workflow)
// ============================================
model Execution {
  id String @id @default(uuid())

  // Estado
  status ExecutionStatus @default(PENDING)

  // Tiempos
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  duration   Int? // En segundos

  // Resultado
  result     Json?
  error      String?
  errorStack String?

  // Trigger
  trigger     TriggerType @default(MANUAL)
  triggerData Json?

  // Debug
  logs        String?
  stepResults Json?

  // Credit System - Costos y Créditos
  cost          Decimal @default(0) @db.Decimal(19, 8) // Costo real en USD (de las APIs de modelos)
  credits       Int     @default(0) // Créditos cobrados según workflow.category (ver WORKFLOW_CATEGORIES)
  tokensUsed    Int? // Total tokens consumidos en esta ejecución
  balanceBefore Int? // Snapshot del balance antes de la ejecución
  balanceAfter  Int? // Snapshot del balance después de la ejecución
  wasOverage    Boolean @default(false) // True si se ejecutó con balance negativo

  // Copia congelada de `Workflow.isInternal` al momento de crear esta ejecución. No es un
  // join: si el workflow se "publica" después (isInternal → false), esta fila sigue
  // reflejando lo que era cuando corrió, para que las stats del cliente no la desentierren
  // retroactivamente.
  isInternalWorkflow Boolean @default(false)

  // Reintentos
  retryCount Int @default(0)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Conversación asociada (opcional - para agentes conversacionales)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // Quién lo ejecutó (opcional)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id])

  // Credit Transaction asociada (para trazabilidad)
  creditTransaction CreditTransaction? @relation("ExecutionTransaction")

  @@index([workflowId])
  @@index([organizationId])
  @@index([conversationId])
  @@index([apiKeyId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([trigger])
  @@index([wasOverage])
  @@index([organizationId, trigger, startedAt])
  @@index([organizationId, wasOverage])
  @@index([organizationId, userId, startedAt])
  @@index([organizationId, apiKeyId, startedAt])
  @@index([workflowId, startedAt])
  @@index([organizationId, startedAt])
  @@index([deletedAt])
  @@map("executions")
}

// ============================================
// TAG
// ============================================
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  workflows Workflow[] @relation("TagToWorkflow")

  @@map("tags")
}

// ============================================
// WHATSAPP CONFIG
// ============================================
model WhatsAppConfig {
  id String @id @default(uuid())

  // Identificación
  phoneNumber String  @unique
  displayName String?
  description String?

  // Proveedor (baileys, twilio, meta)
  provider String

  // Credenciales (referencia a Secret Manager en producción)
  credentialPath String?

  // Webhook
  webhookSecret String  @default(uuid())
  webhookUrl    String?

  // Estado de conexión
  connectionStatus WhatsAppConnectionStatus @default(DISCONNECTED)
  lastConnectedAt  DateTime?
  connectionError  String?

  // QR (para baileys)
  qrCode       String?
  qrCodeExpiry DateTime?

  // Sesión
  sessionData Json?

  // Estado
  isActive Boolean @default(true)

  // Workflow por defecto para mensajes entrantes
  defaultWorkflowId String?
  defaultWorkflow   Workflow? @relation(fields: [defaultWorkflowId], references: [id])

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relación
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Conversaciones por este canal de WhatsApp
  conversations Conversation[]

  // Templates de WhatsApp de esta configuración
  templates    WhatsAppTemplate[]
  cronTriggers WorkflowCronTrigger[]

  // Cuando un workflow tiene más de un número (varios WhatsAppConfig con el mismo
  // defaultWorkflowId), cuál usa `send_bulk_whatsapp` como remitente para templates si la
  // conversación no es por WhatsApp — ahí no hay un número de destino que lo desambigüe solo,
  // a diferencia del webhook de WhatsApp (ese siempre usa el número por el que llegó, nunca
  // este flag). Con un único número por workflow esto no importa: ese es siempre el remitente.
  // NOTE: la unicidad de a lo más un `true` por `defaultWorkflowId` se enforza con un partial
  // unique index en el SQL: WHERE "isDefaultForOutbound" = true. Prisma no soporta partial
  // unique indexes directamente (mismo patrón que ya usa `tenant_tools`, ver ese modelo).
  isDefaultForOutbound Boolean @default(false)

  @@index([phoneNumber])
  @@index([connectionStatus])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([defaultWorkflowId, isDefaultForOutbound])
  @@map("whatsapp_configs")
}

// ============================================
// WHATSAPP TEMPLATES
// ============================================
model WhatsAppTemplate {
  id          String  @id @default(uuid())
  name        String  // Nombre registrado en Meta (ej. "recordatorio_cita")
  displayName String? // Nombre amigable para el UI
  language    String  @default("es_MX")

  // Define qué variables espera cada componente, en orden posicional.
  // Ej: { "body": ["nombre_paciente", "fecha_cita"], "header": [], "buttons": [] }
  variables   Json    @default("{}")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsAppConfigId String
  whatsAppConfig   WhatsAppConfig @relation(fields: [whatsAppConfigId], references: [id], onDelete: Cascade)

  @@index([whatsAppConfigId])
  @@map("whatsapp_templates")
}

// ============================================
// MESSENGER (Página de Facebook)
// ============================================
model MessengerConfig {
  id String @id @default(uuid())

  // Identificación: la página de Facebook es la "cuenta" del canal, el equivalente
  // al número de teléfono en WhatsApp. Meta la manda en cada webhook (`entry[].id`),
  // así que es la llave con la que se resuelve la config del mensaje entrante.
  pageId      String  @unique
  pageName    String?
  description String?

  // Proveedor (meta)
  provider String @default("meta")

  /// Credencial con la que la página HABLA: autoriza a responder por la Send API en
  /// nombre de esta página. Se emite en Meta (Messenger API settings → Access tokens)
  /// y es por página, no por app: dos páginas de la misma app tienen tokens distintos.
  /// Se guarda cifrado con KMS, nunca en claro, y no sale nunca por la API.
  /// Si viene vacío se cae a MESSENGER_PAGE_ACCESS_TOKEN, para despliegues de una
  /// sola página.
  pageAccessToken String?

  /// Credencial con la que la página ESCUCHA: es el App Secret de Meta, con el que se
  /// firma el header `x-hub-signature-256` de cada webhook y por tanto lo que permite
  /// distinguir una entrega legítima de un POST cualquiera contra la URL pública.
  /// A diferencia del token de página es por APP, así que varias páginas de la misma
  /// app comparten valor; esta columna existe para el caso multi-tenant, donde cada
  /// cliente trae su propia app de Meta.
  /// Se guarda cifrado con KMS, nunca en claro, y no sale nunca por la API. Si viene
  /// vacío se cae a MESSENGER_APP_SECRET, para despliegues de una sola app.
  /// Leerlo obliga a resolver esta fila ANTES de validar la firma, con el `pageId` de
  /// un cuerpo todavía sin verificar; ese dato solo elige la llave, nunca da acceso.
  appSecret String?

  // Estado de conexión
  connectionStatus MessengerConnectionStatus @default(DISCONNECTED)
  lastConnectedAt  DateTime?
  connectionError  String?

  // Estado
  isActive Boolean @default(true)

  // Workflow por defecto para mensajes entrantes
  defaultWorkflowId String?
  defaultWorkflow   Workflow? @relation(fields: [defaultWorkflowId], references: [id])

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relación
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Conversaciones por esta página de Messenger
  conversations Conversation[]

  @@index([pageId])
  @@index([connectionStatus])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("messenger_configs")
}

// ============================================
// WORKFLOW CRON TRIGGERS
// ============================================
model WorkflowCronTrigger {
  id             String  @id @default(uuid())
  name           String
  cronExpression String
  timezone       String  @default("UTC")
  triggerMessage String  @db.Text

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  whatsAppConfigId String?
  whatsAppConfig   WhatsAppConfig? @relation(fields: [whatsAppConfigId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([workflowId])
  @@index([isActive])
  @@map("workflow_cron_triggers")
}

// ============================================
// AUDIT LOG
// ============================================
model AuditLog {
  id String @id @default(uuid())

  // Quién hizo la acción (User de la organización)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  userEmail String
  userName  String

  // Qué hizo
  action     String // create, update, delete, login, etc.
  resource   String // organization, user, workflow, etc.
  resourceId String?

  // Request
  method   String // GET, POST, PUT, DELETE
  endpoint String

  // Cambios
  changes  Json? // { before: {}, after: {} }
  metadata Json?

  // Contexto
  ipAddress String
  userAgent String?

  // Resultado
  statusCode   Int
  success      Boolean @default(true)
  errorMessage String?
  duration     Int? // En ms

  // Timestamp
  timestamp DateTime @default(now())

  // Relación opcional
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userEmail])
  @@index([action])
  @@index([timestamp])
  @@index([organizationId])
  @@index([success])
  @@map("audit_logs")
}

model UserVerification {
  id               String   @id @default(uuid())
  email            String   @unique
  userName         String
  organizationName String
  verificationCode String   @unique
  isEmailVerified  Boolean  @default(false)
  isFromInvitation Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("user_verifications")
}

model Notification {
  id              String             @id @default(uuid())
  code            String
  version         Int                @default(1)
  titleTemplate   String
  messageTemplate String
  targetRoles     Json               @db.JsonB
  isActive        Boolean            @default(true)
  users           UserNotification[]
  createdAt       DateTime           @default(now())

  @@unique([code, version])
  @@index([code, isActive])
  @@map("notifications")
}

model UserNotification {
  id              String       @id @default(uuid())
  userId          String
  organizationId  String
  notificationId  String
  isRead          Boolean      @default(false)
  titleSnapshot   String
  messageSnapshot String
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@map("user_notifications")
}

/// Deduplicación de webhooks entrantes.
///
/// Los proveedores (Stripe, YCloud) reintentan ante cualquier respuesta no-2xx,
/// y varios handlers son aditivos (addCredits suma al balance, invoiceItems.create
/// factura al cliente). Sin esta tabla, un reintento duplica créditos y cobros.
///
/// El @@unique([provider, eventId]) es el mecanismo real: si dos instancias de
/// Cloud Run reciben el mismo evento en paralelo, la segunda choca contra el
/// constraint y se rinde. Las filas se purgan a los 30 días vía cron.
model ProcessedWebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  eventType   String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("processed_webhook_events")
}
