# ============================================
# BOOKING (AGENDA PROPIA)
# ============================================
# Cuenta de Workspace que la service account del Gateway suplanta por domain-wide delegation.
# No hay archivo de llave: la SA se firma a si misma con iamcredentials.signJwt, lo que exige
# roles/iam.serviceAccountTokenCreator sobre si misma y autorizar su Client ID numerico en el
# Admin Console para el scope https://www.googleapis.com/auth/calendar.
BOOKING_IMPERSONATED_USER="agenda@fractalops.com.mx"
# Calendario del usuario suplantado donde se crean los eventos.
BOOKING_CALENDAR_ID="primary"
# Google Group del equipo de soporte. Si se define, su disponibilidad se cruza con la del
# calendario destino y se le invita al evento. Vacio = solo el calendario destino.
BOOKING_AVAILABILITY_GROUP_EMAIL=""
# Solo en local: con ADC de usuario no hay client_email que descubrir en el metadata server.
BOOKING_SERVICE_ACCOUNT_EMAIL=""

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_site_key_aqui
FRONTEND_URL="http://localhost:3001"

